<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened runtime (required for notarisation) gates access to TCC-protected
      resources. This is the Resource Access entitlement for the photo library.
      Harmless if redundant, required if it is not -- and the failure mode without it
      is the silent one this project has already been bitten by: no prompt, and Photos
      access denied outright.
    -->
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
</dict>
</plist>
